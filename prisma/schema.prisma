generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role                 String   @default("LANDLORD") // LANDLORD, ADMIN, TENANT
  status               String   @default("APPROVED") // APPROVED, PENDING, REJECTED
  phone                String?
  notificationsEnabled Boolean  @default(true)
  tenant               Tenant?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Property {
  id          String   @id @default(uuid())
  name        String
  address     String
  description String?
  rentAmount  Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenants     Tenant[]
}

model Tenant {
  id             String            @id @default(uuid())
  userId         String?           @unique
  user           User?             @relation(fields: [userId], references: [id])
  name           String
  email          String
  phone          String
  propertyId     String
  property       Property          @relation(fields: [propertyId], references: [id])
  leaseStart     DateTime
  leaseEnd       DateTime?
  rentAmount     Float
  balance        Float             @default(0)
  status         String            @default("ACTIVE") // ACTIVE, PAST
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  payments       Payment[]
  invoices       Invoice[]
  notifications  NotificationLog[]
}

model Payment {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  amount    Float
  date      DateTime @default(now())
  method    String   // CASH, BANK_TRANSFER, MOBILE_MONEY
  reference String?
  status    String   @default("COMPLETED") // COMPLETED, PENDING, FAILED
  type      String   @default("RENT") // RENT, WATER, OTHER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  amount    Float
  dueDate   DateTime
  type      String   // RENT, WATER
  status    String   @default("PENDING") // PAID, PENDING, OVERDUE, PARTIAL
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  type      String   // RENT_REMINDER, PAYMENT_RECEIPT
  channel   String   @default("WHATSAPP")
  status    String   // SENT, FAILED
  sentAt    DateTime @default(now())
}
